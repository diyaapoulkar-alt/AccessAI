# ==========================================
# AccessAI - Environment Configuration
# ==========================================

# Groq API Configuration
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Models:
# Vision model (recommended for alt-text evaluation and image reading):
GROQ_MODEL=llama-3.2-11b-vision-preview

# Alternative fast text-only model:
# GROQ_MODEL=llama-3.3-70b-versatile

# Frontend Groq API key (optional for Vite):
VITE_GROQ_API_KEY=

# Tesseract OCR Executable Path override (optional):
# On Windows, AccessAI automatically detects C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
